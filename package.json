{
  "name": "pi-super",
  "version": "1.2.0",
  "description": "Mobile-first meta-interface to an existing tmux full of pi sessions",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "tmux",
    "terminal",
    "pty",
    "mobile",
    "agent",
    "voice",
    "gpt-live",
    "webauthn",
    "passkeys"
  ],
  "repository": "github:pasky/pi-super",
  "homepage": "https://github.com/pasky/pi-super",
  "bugs": "https://github.com/pasky/pi-super/issues",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "contrib"
  ],
  "type": "module",
  "bin": {
    "pi-super": "dist/server/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:android": "cd android && ./gradlew assembleDebug",
    "test:passkey": "npm run build && node tests/passkey-e2e.mjs",
    "test:android": "npm run build:android && node tests/android-call.mjs",
    "test:mobile": "npm run build && node tests/mobile-shots.mjs",
    "test:voice": "npm run build && node tests/voice-e2e.mjs",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
