{
  "name": "pi-super",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first meta-interface to an existing tmux full of pi sessions",
  "type": "module",
  "bin": {
    "pi-super": "dist/server/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "dev": "npm run build && node dist/server/index.js",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
