<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!--
	  Always dark, explicitly. The first cut set only windowBackground on a DayNight theme,
	  which painted the window pi-super's near-black and left every text colour resolved for
	  light mode: black on black, an invisible setup screen.
	-->
	<style name="Theme.PiSuper" parent="Theme.AppCompat.NoActionBar">
		<item name="android:windowBackground">@color/bg</item>
		<item name="android:colorBackground">@color/bg</item>
		<item name="android:textColorPrimary">@color/fg</item>
		<item name="android:textColorSecondary">@color/fg_dim</item>
		<item name="android:textColorHint">@color/fg_hint</item>
		<item name="colorAccent">@color/accent</item>
	</style>
</resources>
